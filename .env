# Magazoo production settings for Hostinger.
# Set NODE_ENV=production in Hostinger's environment-variable panel.
# Replace your-domain.com with the actual domain connected to this Node.js app.
MAGAZOO_ORIGIN=https://magazoo.usmphysics.org

# Hostinger must allow the app to listen on its assigned public port.
HOST=0.0.0.0

# Generate this value on your laptop with: npm run hash-password
# Paste the complete output below. Never put the plain password here.
MAGAZOO_ADMIN_PASSWORD_HASH=pbkdf2-sha256$310000$LeHmGQCWa_DZhpWy02BEMA$HJhS3IFBm7azb85mwbmbn2rUsirGkykjwSBjHKynZzc

# Do not set PORT here. Hostinger supplies the correct port automatically.
